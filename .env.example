# Public browser configuration ONLY. Do not commit secret or service-role keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Configure server-side environment variables in Supabase Edge Functions:
# SUPABASE_URL (provided by Supabase)
# SUPABASE_SERVICE_ROLE_KEY (server only)
# PAYSTACK_SECRET_KEY (server only)
# PAYSTACK_WEBHOOK_SECRET (server only, if different)
# RESEND_API_KEY (server only)
# RESEND_FROM_EMAIL=admissions@your-verified-domain.example
